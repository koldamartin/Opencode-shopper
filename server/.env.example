# OpenCode Server Configuration

# Server Port (default: 4096, Render.com uses $PORT)
PORT=4096

# Server Hostname (default: 0.0.0.0 for Docker/Render, 127.0.0.1 for local)
HOSTNAME=0.0.0.0

# Node Environment
NODE_ENV=production

# Model Configuration
OPENCODE_MODEL=openai/gpt-4o

# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here